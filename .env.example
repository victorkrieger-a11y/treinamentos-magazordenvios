# =============================================================================
# Treinamentos Magazord Envios — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# NUNCA versione valores reais.
# =============================================================================

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon / publishable). Pode ser exposta ao navegador:
# o acesso aos dados é protegido por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role (secret). SOMENTE servidor. Nunca use o prefixo NEXT_PUBLIC_.
# Usada apenas para provisionar contas (convites) e bloquear usuários desativados.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação (usada nos links de convite e recuperação de senha)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
